# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Required ────────────────────────────────────────────────────────────────

# OpenAI API key — used for Whisper (speech-to-text) and GPT-4o-mini (cues & summary)
OPENAI_API_KEY=sk-...

# ── Optional (local dev) ────────────────────────────────────────────────────

# Salesforce CLI org alias to use for read/write queries (default: evenTest)
SF_TARGET_ORG=evenTest

# Override the GPT model used for cues and summaries (default: gpt-4o-mini)
# OPENAI_CHAT_MODEL=gpt-4o

# ── Heroku / production only ─────────────────────────────────────────────────
# Long-lived Salesforce credential — never commit this value.
# Generate with: sf org display --verbose --target-org evenTest --json | jq -r '.result.sfdxAuthUrl'
# SFDX_AUTH_URL=force://...

# ── Optional: Agentforce (voice search feature) ──────────────────────────────
# AGENTFORCE_AGENT_ID=0Xx...
# AGENTFORCE_DOMAIN=https://your-org.my.salesforce.com
# AGENTFORCE_CLIENT_ID=...
# AGENTFORCE_CLIENT_SECRET=...
